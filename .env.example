# 岩滝・網野自動車教習所 — 環境変数サンプル（tech-stack §4.5）
# すべてサーバー限定・クライアント非公開。実値はコミットしない（.env をリポジトリに含めない）。
# Vercel の各サービス連携で自動注入される標準キー名に合わせる。

# --- Vercel Postgres（DBアクセスはサーバー限定, §1.2）---
POSTGRES_URL=                 # Prisma pooled 接続
POSTGRES_URL_NON_POOLING=     # migrate 用 direct 接続
POSTGRES_PRISMA_URL=          # Prisma 用（pgbouncer付き）

# --- Vercel Blob（免許証写真・非公開, F-009/F-018）---
BLOB_READ_WRITE_TOKEN=        # サーバーからのアップロード/署名URL発行

# --- Vercel KV（レート制限・Upstash Redis, REV-012）---
# ★P3-a から **本番で必須**（未設定なら lib/env.ts が起動時に throw / SEC-033 / AC-010-10）。
# 未設定のまま起動するとレート制限とセマフォが黙って無効化される（インメモリへ落ちると
# インスタンスごとに別カウンタになり「全体流量制御」にならない）＝ 動いてしまうことが最も危険。
# **`next build` 時にも必要**（AUTH_SECRET と同じ理由。RV-P2R-005）。
# 実体は Upstash Redis（Vercel KV はサービス提供終了。tech-stack §4.5）。
# ★P3-b から **公開エンドポイントが実際に KV を叩く**（lib/runtime-stores.ts が全 limiter と
# セマフォへ注入する / SEC-044 の是正）。実在しないホストを書くと全リクエストが 500 になる。
# **ローカル / E2E 用の逃げ道**: `memory://local-dev-only` を入れるとインメモリで動く
# （lib/runtime-stores.ts の isKvConfigured は https:// のみを「設定済み」と見なす）。
# 本物の本番（VERCEL=1）では lib/env.ts が https:// 以外を起動時に拒否するため漏れない。
KV_REST_API_URL=              # 本番: https://<id>.upstash.io / ローカル: memory://local-dev-only
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=  # 読み取り専用（任意）

# --- 認証（Auth.js / NextAuth v5, F-012）---
AUTH_SECRET=                  # セッション署名（`openssl rand -base64 32`）
                              # 本番は 32文字以上が必須。未設定/短い値は起動時に検証エラー（SEC-013）
                              # **ランタイムだけでなく `next build` 時にも必要**（RV-P2R-005）。
                              # ビルドはページを評価するため auth.ts の getServerEnv() が走る。
                              # CI/デプロイのビルド環境にも必ず注入すること
                              # （CI は .github/workflows/ci.yml の e2e-test ジョブでダミーを渡す）。
# AUTH_*                      # プロバイダ別資格情報（方式確定後: tech-stack §6 #1）

# --- デモ用管理者（seed が投入。開発専用・本番不可, F-012）---
ADMIN_EMAIL=                  # 管理者ログインID（例: admin@example.com）
ADMIN_NAME=                   # 管理者表示名
ADMIN_PASSWORD=               # 管理者パスワード（seed が scrypt でハッシュ化）
                              # 必須。未設定なら seed は既定値へフォールバックせず throw（SEC-012）。
                              # 推測困難な値を使うこと。seed 自体が本番では実行不可
                              # （NODE_ENV=production は ALLOW_PROD_SEED=1 の明示オプトインが必要）

# --- スパム対策 / メール ---
TURNSTILE_SECRET=             # サーバー検証（F-010）。**P3-b で本番必須へ昇格済み**
                              # （未設定だと lib/env.ts が起動時に throw する）。
                              # ローカル / E2E は Cloudflare のテスト用キー（常に成功）でよい:
                              #   1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=  # ウィジェット描画用（クライアント公開前提）。**P3-b で本番必須**
                              # ローカル / E2E のテスト用キー: 1x00000000000000000000AA
RESEND_API_KEY=               # 申込完了の自動返信（F-010）
                              # **本番 fail-fast の対象にはしない**——必須化すると自動返信の
                              # 未設定が申込受付そのものを止めてしまう。未設定時は送信せずに戻る
                              # （lib/mail.ts）。運用開始時に必ず設定すること

# --- 公開フォーム基盤（P3-a で本番必須。tech-stack §4.6）---
FORM_SESSION_SECRET=          # フォームセッション Cookie の署名鍵（AC-RL-13）
                              # **本番は 32 文字以上**（P3b-3 / SEC-046。縮退時に残る唯一の
                              # Tier D 軸が Cookie 軸になったため、弱い鍵は軸そのものの無効化を意味する）。
                              # **AUTH_SECRET / CRON_SECRET と同一値は不可**（lib/env.ts が拒否する）。
                              # 同一鍵を Cookie 署名とセッション JWT 署名に使うと、
                              # 片方の漏えいが両方に波及する（鍵の用途分離）。
                              # 実際の署名鍵はここから HKDF で用途別に導出される。
CRON_SECRET=                  # 保持期間削除 / orphan 回収バッチの起動認可（AC-PII-10）
                              # **本番は 32 文字以上**（P3b-3 / SEC-046）。
                              # 未設定のまま /api/cron/** を公開すると
                              # **未認証の削除エンドポイント**になる。未設定時は 404 で fail-closed。

# --- 公開設定（クライアント可・機微情報は入れない）---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
